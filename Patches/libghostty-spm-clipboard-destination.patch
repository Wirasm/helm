 .../TerminalClipboardDestination.swift        | 71 +++++++++++++++++++
 .../TerminalController+Callbacks.swift        | 41 ++++++++++-
 .../TerminalController+Config.swift           | 12 +++-
 .../TerminalClipboardDestinationTests.swift   | 49 +++++++++++++
 4 files changed, 171 insertions(+), 2 deletions(-)
 create mode 100644 Sources/GhosttyTerminal/Controller/TerminalClipboardDestination.swift
