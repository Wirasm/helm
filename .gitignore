.build/
.swiftpm/
*.xcodeproj
xcuserdata/
# generated by xcodegen (see project.yml info.path)
/Info.plist
vendor/
DerivedData/
.DS_Store

.worktrees/

# Archon keeps per-repo run state here. Local, never this repo's to carry — one
# `git add -A` swept a 696-line workflow file into an unrelated fix (#263). The one
# exception is the helm workflow pack, which is versioned on purpose (#420).
.archon/*
!.archon/workflows/
.archon/workflows/*
!.archon/workflows/helm/
