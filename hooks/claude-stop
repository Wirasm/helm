#!/bin/sh
# helm-mail → Claude Code `Stop` hook: deliver waiting mail at the end of a turn. Issue #56.
# Claiming is the sibling hook, `claude-session-start`, and must be wired too — this one
# delivers to a mailbox it does not create.
#
#   ~/.claude/settings.json, alongside whatever Stop hooks are already there:
#     { "type": "command", "command": "/abs/path/to/helm/hooks/claude-stop", "timeout": 5 }
#
# THE EXIT CODE IS THE MECHANISM. 0 is silence and the common case. **2 blocks the stop and
# hands this hook's stderr to the model**, which is how the mail arrives without a human
# prompting for it. Everything else exits 0, because a hook that cannot deliver must never
# stop the operator finishing a turn.
#
# Runs SYNCHRONOUSLY and does not park. kild's `kild-rewake.sh` parks in the background under
# `asyncRewake: true` for eight hours so a genuinely idle session can be woken; that is a real
# capability and its absence here is a decision, not an oversight — pi delivers on
# `agent_settled` and nothing else, so a Claude Code session delivering on `Stop` is exactly
# symmetric with it. Mail to a session that never takes another turn waits for one.
set -u

if ! command -v node >/dev/null 2>&1; then
	cat >/dev/null 2>&1 || true
	exit 0
fi

exec node "$(dirname "$0")/helm-mail.mjs" drain
